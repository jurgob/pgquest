{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "format:fix": {
      "cache": false
    },
    "typecheck": {
      "outputs": [".react-router/**"]
    },
    "test": {
      "outputs": []
    },
    "cli": {
      "outputs": []
    },
    "build-assets:search-index": {
      "dependsOn": ["build-assets:pgexamples"],
      "inputs": [
        "scripts/build-search-index.tsx",
        "app/routes/**",
        "app/sql/**",
        "cli_examples/**",
        "vite.cli.config.ts"
      ],
      "outputs": ["app/generated/search-index.json"]
    },
    "build-assets:sitemap": {
      "inputs": [
        "scripts/build-sitemap-lastmod.ts",
        "app/routes/**",
        "app/sql/lesson-catalog.ts",
        "cli_examples/**",
        "vite.cli.config.ts"
      ],
      "outputs": ["app/generated/sitemap-lastmod.json"]
    },
    "build-assets:pgexamples": {
      "inputs": [
        "scripts/build-postgres-examples.ts",
        "app/sql/lesson-catalog.ts",
        "app/sql/run-example.ts",
        "cli_examples/**",
        "vite.cli.config.ts"
      ],
      "outputs": ["app/generated/postgres-examples.json"]
    },
    "build": {
      "dependsOn": [
        "typecheck",
        "build-assets:search-index",
        "build-assets:sitemap",
        "build-assets:pgexamples"
      ],
      "outputs": ["build/**"]
    },
    "build-assets:check": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev:app": {
      "cache": false,
      "persistent": true
    },
    "dev:pg": {
      "cache": false,
      "persistent": true
    },
    "dev:native:app": {
      "cache": false,
      "persistent": true
    }
  }
}
