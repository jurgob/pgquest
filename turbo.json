{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "format:fix": {
      "cache": false
    },
    "typecheck": {
      "outputs": [".react-router/**"]
    },
    "test": {
      "outputs": []
    },
    "cli": {
      "outputs": []
    },
    "search:index": {
      "inputs": [
        "scripts/build-search-index.tsx",
        "app/routes/**",
        "app/sql/**",
        "cli_examples/**",
        "vite.cli.config.ts"
      ],
      "outputs": ["app/sql/search-index.generated.json"]
    },
    "build": {
      "dependsOn": ["typecheck", "search:index"],
      "outputs": ["build/**"]
    },
    "dev:app": {
      "cache": false,
      "persistent": true
    },
    "dev:native:app": {
      "cache": false,
      "persistent": true
    }
  }
}
