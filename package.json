{
  "name": "pgquest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "all": "turbo run lint format typecheck test cli build --concurrency=100%",
    "all:fix": "turbo run lint:fix format:fix --concurrency=100%",
    "build": "react-router build",
    "cli": "vite-node --config ./vite.cli.config.ts ./scripts/run-cli-examples.ts",
    "dev": "CHOKIDAR_USEPOLLING=1 react-router dev --port 9999",
    "dev:native": "react-router dev --port 9999",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "react-router-serve ./build/server/index.js",
    "ship": "./scripts/ship.sh",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@electric-sql/pglite": "^0.5.8",
    "@lezer/highlight": "^1.2.3",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "isbot": "^5.1.36",
    "neverthrow": "^8.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.2",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.3",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
